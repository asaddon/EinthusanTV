# ==========================================
# EINTHUSAN CREDENTIALS (REQUIRED)
# ==========================================
# Your Einthusan TV login credentials (needed to access full streams and bypass public limits).
LOGIN_EMAIL=your_email@example.com
LOGIN_PASSWORD=your_password

# ==========================================
# CLOUDFLARE KV CACHING (RECOMMENDED)
# ==========================================
# Use Cloudflare KV for the free L2 persistent cache (protects against rate limits and enables fast Stremio search).
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_KV_NAMESPACE_ID=your_cloudflare_kv_namespace_id
CF_API_TOKEN=your_cloudflare_api_token

# ==========================================
# REDIS CACHING (ALTERNATIVE L2 CACHE)
# ==========================================
# If you prefer Redis instead of Cloudflare KV, provide your connection URL (e.g. from Upstash).
# REDIS_URL=rediss://default:password@your-redis-url:6379

# ==========================================
# APP CONFIGURATION (OPTIONAL)
# ==========================================
# The port the Node.js app runs on (Defaults to 3000 if not set, Hugging Face uses 7860).
PORT=3000

# Set a keep-alive URL to ping the app every 10 minutes to prevent it from sleeping on free hosts (Render/Hugging Face).
# KEEP_ALIVE_URL=https://your-app-url.onrender.com/

# Enable colored output in console logs ('true' or 'false')
USE_COLORS=true